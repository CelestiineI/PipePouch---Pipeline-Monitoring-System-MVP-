<!DOCTYPE html>
<html lang="en">

<body>
    <%- include('partials/header') %>
    <div class="container">
        <h1>Monitoring</h1>
        <h2>Pipeline Parameters:</h2>
        <ul>
            <% for(const [key, value] of Object.entries(pipelineParameters)) { %>
                <li><%= key %>: <%= value %></li>
            <% } %>
        </ul>
        <h2>Rupture Thresholds:</h2>
        <ul>
            <% for (const [key, value] of Object.entries(ruptureThresholds)) { %>
                <li><%= key %>: <%= value %></li>
            <% } %>
        </ul>

    </div>

    <%- include('partials/footer') %>
</body>
</html>